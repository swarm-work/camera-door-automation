# Every variable reconciler.py reads. Anything not listed here is ignored.
# Copy to .env and edit. Delete lines you don't want — do NOT blank them:
# an empty value is not the same as an absent one and will crash or flip a default.

# --- Fregata (source of truth; read-only) ---
# Absolute paths. FREGATA_RECORDINGS_DIR must be the exact prefix of the values
# in the recordings.path column, or S3 keys land under a hashed external/ path.
#   sqlite3 -readonly "$FREGATA_DB_PATH" "SELECT path FROM recordings LIMIT 1;"
FREGATA_DB_PATH=~/Fregata/config/frigate.db
FREGATA_RECORDINGS_DIR=~/Fregata/media/recordings

# --- Local state (this program's own bookkeeping) ---
# Must be a FILE path, not a directory. Use an absolute path: the default is
# relative to the working directory, so running from elsewhere creates a second
# empty state DB and re-uploads everything.
STATE_DB_PATH=./reconciler-state.db

# --- Filters (exact string match; a mismatch returns 0 rows and exits 0) ---
# Get the real values from your database, don't guess:
#   sqlite3 -readonly "$FREGATA_DB_PATH" "SELECT DISTINCT camera, label FROM event;"
# CAMERA unset means NO camera filter — every camera on the NVR.
CAMERA=door_camera
LABEL=person

# --- Clip padding (seconds) ---
# Detector boundaries are not event boundaries. Without padding, short events
# produce unwatchable clips. Bare numbers only; "10s" is a startup crash.
PRE_ROLL_SECONDS=10
POST_ROLL_SECONDS=15

# --- S3 (AWS shown; for Cloudflare R2 set S3_ENDPOINT_URL and AWS_REGION=auto) ---
# Credentials are read by boto3 itself, so they must use the AWS_ names.
# The IAM policy needs PutObject, GetObject and AbortMultipartUpload on
# arn:aws:s3:::YOUR-BUCKET/<S3_PREFIX>/* — GetObject is required because every
# upload is followed by head_object.
S3_BUCKET=
S3_PREFIX=fregata
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com

# --- Notion (omit the token or the database id to disable) ---
# Token: Notion Developer portal -> Internal connections -> Configuration tab.
# Database id: the 32 hex characters in the database page URL, before the "?".
# The integration must ALSO be shared with the database: open it, ••• menu ->
# Connections -> Add connection. That step is not an API call and is easy to miss.
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_VERSION=2026-03-11
# sub_label is a real person's name from face recognition. Off by default: with this false
# every page reads "Unrecognized". Turn it on only if you intend to publish names to Notion.
NOTION_INCLUDE_PERSON=false
# Give up on an event after this many failed Notion attempts, so one dead event cannot be
# retried on every poll forever ahead of the person actually at your door.
NOTION_MAX_ATTEMPTS=5

# --- Behaviour ---
# DRY_RUN accepts only 1/true/yes/on. Every other value, including a typo or an
# empty string, means LIVE. It fails toward uploading.
DRY_RUN=true
# The manifest embeds the whole event row, including sub_label — which is a real
# person's name when face recognition is on. Filter those fields before enabling.
# Off in code as well as here, so deleting this line does not silently enable it.
UPLOAD_EVENT_MANIFEST=false
POLL_SECONDS=30
SETTLE_SECONDS=5
LOG_LEVEL=INFO

# --- Clip links (optional; no server, no VPN) ---
# CLIP_LINKS=true writes a presigned S3 URL into the Notion database's "Clip"
# property (type URL — create it first; test-notion.py checks it). The URL opens a
# small viewer page hosted in the bucket, one <video> per segment. Signatures live
# CLIP_URL_TTL_SECONDS and the poll loop re-signs any link older than
# CLIP_REFRESH_SECONDS, so links in Notion stay working as long as the reconciler
# runs. TTL minus refresh age is how long the Mac can be off before links go dead
# (defaults: 7d - 5d = 2 days of slack); they heal on the next pass either way.
# The link is a bearer token: ANYONE who can see the Notion page can watch that
# event until the signature expires. Keep Notion publish-to-web off. See README.
# AWS_REGION must match the bucket's region: uploads survive a mismatch, but the
# presigned links fail at click time (the refresh pass click-checks one per pass).
CLIP_LINKS=false
CLIP_URL_TTL_SECONDS=604800
CLIP_REFRESH_SECONDS=432000
# Optional: sign clip links with a SEPARATE read-only IAM user (GetObject on the
# prefix only). Deactivating that key instantly kills every link ever handed out,
# without stopping uploads. Leave unset to sign with the main credentials.
# CLIP_AWS_ACCESS_KEY_ID=
# CLIP_AWS_SECRET_ACCESS_KEY=

# --- Slack end-of-day summary (omit the webhook URL to disable) ---
# One message per local day at SLACK_SUMMARY_TIME (HH:MM, 24h, Mac's timezone),
# posted from the normal watch loop: every event since the previous summary whose
# face recognition matched nobody. No per-event pings, no names, no presigned
# clip URLs — each line links to the event's Notion page instead. If the Mac is
# asleep at summary time, the next pass catches up with one combined message.
# Webhook: Slack -> your app -> Incoming Webhooks (or the "Incoming WebHooks"
# legacy integration) -> pick the channel. Test with:
#   python3 reconciler.py slack-summary
SLACK_WEBHOOK_URL=
SLACK_SUMMARY_TIME=21:00
# A quiet day posts nothing. Set true to get a "no unknown visitors" line instead,
# if you want proof-of-life that the summary itself still works.
SLACK_SUMMARY_ON_EMPTY=false
# Include recognized (known) visitors in the summary. Off by default because
# person names come from face recognition and the privacy invariant requires
# an explicit opt-in before names reach any output path.
SLACK_INCLUDE_KNOWN=false
# Include event snapshots beside unknown visitor rows in Slack. Off by default:
# these are biometric face images, and Slack requires presigned S3 image URLs in
# the message payload because incoming webhooks cannot upload binary files.
SLACK_INCLUDE_SNAPSHOTS=false
# Require Frigate's saved event metadata to contain a detected `face` attribute
# before an unnamed person appears in the unknown-visitor summary. This suppresses
# typical back-of-head exit events, but can omit a real entrant whose face was
# never visible. It affects Slack only; S3 and Notion delivery remain unchanged.
SLACK_UNKNOWN_REQUIRES_FACE=false
